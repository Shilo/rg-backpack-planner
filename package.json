{
    "name": "backpack-planner",
    "version": "0.3.14",
    "displayName": "Backpack Planner",
    "description": "Plan and share Backpack Tech builds.",
    "app": {
        "sourceUrl": "https://github.com/shilo/rg-backpack-planner",
        "productionUrl": "https://rgbp.app"
    },
    "author": {
        "name": "Shilo",
        "url": "https://github.com/shilo"
    },
    "game": {
        "name": "Run! Goddess",
        "url": "https://rungoddess.topgamesinc.com"
    },
    "premadeBuilds": [
        "Starter|_",
        "Early_Stun|_",
        "Late_PvE|_",
        "Late_PvP|_"
    ],
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/copy-404.cjs",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
        "test:ui:tier": "tsx test/tierLeveling.ui.test.ts",
        "test": "npm run check && tsx test/index.ts",
        "pwa:assets": "node scripts/generate-pwa-icons.mjs",
        "update": "npx npm-check-updates -u && npm install svelte-whisper@github:Shilo/svelte-whisper && npm install"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^25.3.3",
        "phosphor-svelte": "^3.1.0",
        "playwright": "^1.58.2",
        "sharp": "^0.34.5",
        "svelte": "^5.53.7",
        "svelte-check": "^4.4.4",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-pwa": "^1.2.0"
    },
    "dependencies": {
        "@zumer/snapdom": "^2.0.2",
        "svelte-whisper": "github:Shilo/svelte-whisper"
    }
}
